# Private deployment is locked until BOTH values are configured.
# Choose a unique random password (minimum 12 characters).
STUDIO_PASSWORD=
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_SESSION_SECRET=

# Keep false. This enables only the existing legacy MuAPI proxies when explicitly
# changed to true. The personal studio never selects or calls a paid provider.
ENABLE_PAID_APIS=false

# Optional: server-only token for READ-ONLY ZeroGPU quota inspection.
# Fine-grained permission: Billing > Read billing usage and payment method status.
# Does NOT enable authenticated upload/generation, even with sufficient quota.
# Leave empty unless you explicitly want quota inspection after reviewing the PR.
HF_TOKEN=

# No GPU server, database or ElevenLabs key is required.

# Phase 3: optional private cloud STORAGE only; disabled by default.
# Render remains separately disabled; review Phase 3B cost approval before setup.
STUDIO_CLOUD_STORAGE_ENABLED=false
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_REGION=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
STUDIO_CLOUD_OWNER_ID=
# Review the Free/no-upgrade account and SQL setup in docs/PHASE3-BULUT-SHORTS.md.
# All values stay server-side. Never create NEXT_PUBLIC variants.

# Phase 3B: disabled unless explicit approval accepts possible Google charges.
STUDIO_CLOUD_RENDER_ENABLED=false
STUDIO_RENDER_COST_APPROVAL_EXPIRES_AT=
STUDIO_RENDER_WORKER_SECRET=
GCP_RENDER_PROJECT_ID=
GCP_RENDER_PROJECT_NUMBER=
GCP_RENDER_REGION=
GCP_RENDER_JOB=
GCP_RENDER_WIF_POOL=
GCP_RENDER_WIF_PROVIDER=
GCP_RENDER_INVOKER_NAME=
# Vercel supplies OIDC dynamically; never paste Google access tokens or SA keys.
